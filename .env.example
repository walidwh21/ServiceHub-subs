# Copy to .env (or export in your shell). Nothing here is a real credential.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# One of: generic, tesla, google, microsoft, spotify
BRAND=generic
# Optional SMTP for the contact form (console backend is used when EMAIL_HOST is empty)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
CONTACT_RECIPIENT=
